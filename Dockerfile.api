FROM python:3.11-slim-bookworm

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Only the public API proxy layer is needed here.
COPY api_gateway.py shared_models.py worker_client.py ./

EXPOSE 8088

CMD ["uvicorn", "api_gateway:app", "--host", "0.0.0.0", "--port", "8088"]
